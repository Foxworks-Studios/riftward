    rooms: {
        "archery_butts": (
            name: "Archery Butts",
            description: "A long strip of trampled grass runs along the inside of the wall, ending at straw targets stuffed into wooden frames. The targets bristle with broken shafts, and a rack of practice bows waits beneath a lean-to.",
            exits: {
                "west": "north_gate",
            },
        ),
        "armory": (
            name: "Armory",
            description: "Racks of spears, crossbows and shields stand in careful order, each one tallied in the quartermaster\'s ledger.",
            exits: {
                "west": (
                    to: "garrison_yard",
                    door: "armory_door",
                ),
            },
            indoors: true,
        ),
        "back_alley": (
            name: "Back Alley",
            description: "A narrow alley behind the stalls, cluttered with broken crates and the market\'s refuse. A rusted grate in the cobbles drains into the dark below, and the place smells like it.",
            exits: {
                "down": (
                    to: "sewers:outfall",
                    door: "sewer_grate",
                ),
                "north": "stalls",
            },
        ),
        "barracks": (
            name: "Barracks",
            description: "Rows of narrow bunks and footlockers, smelling of sweat, oil and woodsmoke. Off-duty soldiers dice and doze between watches.",
            exits: {
                "south": "garrison_yard",
            },
            indoors: true,
        ),
        "contract_hall": (
            name: "Contract Hall",
            description: "A quieter room where the guild\'s work is posted. A great board is layered with contracts, bounties and warnings, the older ones curling at the edges beneath the newer.",
            exits: {
                "east": "guildhall",
            },
            no_wander: true,
            indoors: true,
        ),
        "garrison_yard": (
            name: "Garrison Yard",
            description: "A packed-earth yard enclosed by the garrison\'s barracks and storehouses. Soldiers drill in ranks while a sergeant bellows the count.",
            exits: {
                "down": (
                    to: "sewers:garrison_drain",
                    door: "garrison_grate",
                ),
                "east": (
                    to: "armory",
                    door: "armory_door",
                ),
                "north": "barracks",
                "south": "training_yard",
                "west": "high_street",
            },
        ),
        "great_hall": (
            name: "Great Hall",
            description: "The lord\'s great hall, hung with faded tapestries and lit by high windows. A long table runs beneath a raised dais where the lord holds court and hears petitions.",
            exits: {
                "north": "keep_courtyard",
                "up": (
                    to: "lords_solar",
                    door: "solar_door",
                ),
            },
            indoors: true,
        ),
        "guild_archive": (
            name: "Guild Archive",
            description: "Shelves of ledgers, maps and battered books fill this cramped room, the guild\'s long memory of what lies beyond the walls. A reading desk sits beneath the only window, and a locked case holds the volumes the guild guards most closely.",
            exits: {
                "west": "guildhall",
            },
            no_wander: true,
            indoors: true,
        ),
        "guild_cellar": (
            name: "Guild Cellar",
            description: "A low stone cellar crowded with barrels, sacks and crates of the guild\'s stores. In the far corner an iron hatch is set into the floor, padlocked and smelling faintly of the sewers.",
            exits: {
                "down": (
                    to: "sewers:guild_drain",
                    door: "guild_hatch",
                ),
                "up": "guildhall",
            },
            indoors: true,
        ),
        "guild_quarters": (
            name: "Guild Quarters",
            description: "A narrow upstairs corridor lined with plain sleeping rooms, rented by the night to members between contracts.",
            exits: {
                "down": "guildhall",
            },
            no_wander: true,
            indoors: true,
        ),
        "guild_row": (
            name: "Guild Row",
            description: "A broad street of timber-framed halls runs west from the market. The largest bears a painted sign of a sword crossed over a lantern: the Adventurers\' Guild.",
            exits: {
                "down": (
                    to: "sewers:guild_tunnel",
                    door: "guild_grate",
                ),
                "east": "market",
                "north": (
                    to: "guildhall",
                    door: "guild_doors",
                ),
            },
        ),
        "guildhall": (
            name: "Adventurers\' Guildhall",
            description: "A long common hall with a roaring hearth, scarred tables and a crowd of adventurers trading stories and lies. Trophies from beyond the walls hang from the rafters, some of them still unsettling to look at.",
            exits: {
                "down": "guild_cellar",
                "east": "guild_archive",
                "south": (
                    to: "guild_row",
                    door: "guild_doors",
                ),
                "up": "guild_quarters",
                "west": "contract_hall",
            },
            indoors: true,
        ),
        "herbalist": (
            name: "Herbalist\'s Stall",
            description: "Bundles of drying herbs hang thick from the poles of this cramped stall, and shelves of stoppered jars line its back wall. The air is green and bitter with crushed leaves.",
            exits: {
                "south": "stalls",
            },
            no_wander: true,
        ),
        "high_street": (
            name: "High Street",
            description: "The town\'s main street climbs gently south from the market toward the walls of the keep. Wealthier houses stand here, and the garrison\'s banners hang over a gateway to the east.",
            exits: {
                "down": (
                    to: "sewers:great_drain",
                    door: "high_street_grate",
                ),
                "east": "garrison_yard",
                "north": "market",
                "south": "keep_gate",
                "west": "shrine",
            },
        ),
        "keep_courtyard": (
            name: "Keep Courtyard",
            description: "A cobbled courtyard inside the keep\'s walls, busy with servants, horses and messengers. Steps climb to the battlements and the watchtower above.",
            exits: {
                "down": "keep_dungeon",
                "north": (
                    to: "keep_gate",
                    door: "keep_gates",
                ),
                "south": "great_hall",
                "up": "watchtower",
            },
        ),
        "keep_dungeon": (
            name: "Keep Dungeon",
            description: "A row of damp cells beneath the keep, most of them empty, their doors hanging open. Water seeps down the walls, and a stout iron door at the end of the passage leads deeper still.",
            exits: {
                "down": (
                    to: "sewers:sluice",
                    door: "dungeon_door",
                ),
                "up": "keep_courtyard",
            },
            indoors: true,
        ),
        "keep_gate": (
            name: "Keep Gatehouse",
            description: "A thick-walled gatehouse guards the way into the lord\'s keep, its gates studded with iron. Guards in the lord\'s colours stand watch beneath the arch.",
            exits: {
                "north": "high_street",
                "south": (
                    to: "keep_courtyard",
                    door: "keep_gates",
                ),
            },
        ),
        "lords_solar": (
            name: "Lord\'s Solar",
            description: "The lord\'s private chamber: a warm, book-lined room with a wide desk covered in maps, letters and reports from the border.",
            exits: {
                "down": (
                    to: "great_hall",
                    door: "solar_door",
                ),
            },
            no_wander: true,
            indoors: true,
        ),
        "market": (
            name: "Market Square",
            description: "\"\"",
            exits: {
                "down": (
                    to: "sewers:market_drain",
                    door: "market_grate",
                ),
                "east": "stalls",
                "north": "north_gate",
                "south": "high_street",
                "west": "guild_row",
            },
        ),
        "north_gate": (
            name: "North Gate",
            description: "The town wall breaks here around a squat stone gatehouse, its gates propped open for the day\'s traffic. Watchmen lean on their spears and study every traveller who comes in off the forest road.",
            exits: {
                "down": (
                    to: "sewers:north_trunk",
                    door: "gate_grate",
                ),
                "east": "archery_butts",
                "north": "forest:road",
                "south": "market",
            },
        ),
        "shrine": (
            name: "Wayside Shrine",
            description: "A small stone shrine set back from the street, lit by guttering candles and heaped with offerings. Travellers stop here to give thanks for safe roads, or to ask for them.",
            exits: {
                "east": "high_street",
            },
            no_wander: true,
            indoors: true,
        ),
        "stalls": (
            name: "Vendor Stalls",
            description: "Rows of canvas-roofed stalls crowd the east side of the square, selling everything from boot leather to bolts of dyed wool. Merchants watch their goods with one eye and the crowd with the other.",
            exits: {
                "down": (
                    to: "sewers:stalls_culvert",
                    door: "stalls_grate",
                ),
                "east": "tinkers_corner",
                "north": "herbalist",
                "south": "back_alley",
                "west": "market",
            },
        ),
        "tinkers_corner": (
            name: "Tinkers\' Corner",
            description: "Tinkers and menders have claimed this corner of the market, their benches cluttered with pots, locks, lanterns and half-mended tools. Something is always being hammered back into shape.",
            exits: {
                "west": "stalls",
            },
        ),
        "training_yard": (
            name: "Training Yard",
            description: "Battered wooden posts and straw-stuffed dummies stand in rows across this practice ground, hacked nearly to splinters. Racks of blunted weapons line the walls, and the sand of the sparring circle is churned with footprints.",
            exits: {
                "north": "garrison_yard",
            },
        ),
        "watchtower": (
            name: "Watchtower",
            description: "From the top of the keep\'s tallest tower the whole of Riftwatch spreads out below, and beyond the walls the land runs on to the horizon, where the faint shimmer of the barrier hangs in the air.",
            exits: {
                "down": "keep_courtyard",
            },
        ),
    },
)
