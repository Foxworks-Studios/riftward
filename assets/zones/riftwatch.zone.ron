        "training_dummy": (
            name: "a straw training dummy",
            keywords: [
                "dummy",
                "straw",
                "training",
            ],
            here: "A straw training dummy stands on its post, hacked and patched many times over.",
            description: "A man-shaped bundle of straw lashed to a stout post, wearing a dented pot for a helm. It has been slashed, stabbed, punched and set on fire, and patched after every one. It doesn\'t hit back, which is the whole idea.",
            attributes: {
                Body: 1,
                Agility: 1,
                Reaction: 1,
