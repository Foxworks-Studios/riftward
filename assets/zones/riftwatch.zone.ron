            ],
            allies: [
                "townsfolk",
                "players",
            ],
        ),
        "tinker": (
            name: "the tinker",
            keywords: [
                "tinker",
                "mender",
            ],
            here: "The tinker sits at a cluttered bench, hammering a dent out of a pot.",
            description: "A wiry woman with soot to her elbows and a dozen tools hung from her belt. Her bench is heaped with blades to sharpen, locks to mend and things nobody else wanted, and she\'ll buy almost anything if the price is low enough.",
            race: "dwarf",
            attributes: {
                Charisma: 4,
            },
            skills: {
                "trade:haggling": 6,
            },
            tags: [
                "townsfolk",
